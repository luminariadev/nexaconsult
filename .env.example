APP_NAME=NexaConsult
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE CONFIGURATION
# MongoDB is used as primary engine (if available), with automatic fallback to MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=nexaconsult
DB_USERNAME=root
DB_PASSWORD=

# MONGODB CONNECTION
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=nexaconsult

# SESSION & CACHE (File-based for high resiliency)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ========================================
#   AI ENGINE SETUP (9ROUTER / GEMINI)
# ========================================
AI_PROVIDER=9router
AI_BASE_URL=http://127.0.0.1:20128/api/v1
AI_API_KEY=your_9router_api_key_here
AI_MODEL=mr-loverman

# ========================================
#   SECURITY & AUTHENTICATION (JWT)
# ========================================
JWT_SECRET=your_random_64_character_jwt_secret_key_here
JWT_EXPIRE=2592000

VITE_APP_NAME="${APP_NAME}"
